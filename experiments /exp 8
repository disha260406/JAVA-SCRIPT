<! doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Gym Fitness | Admission</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Manrope:wght@400;500;600; 700;800&display=swap" rel="stylesheet
<link rel="stylesheet" href="styles.css" />
<script src="script.js" defer></script>
</head>
<body:
main class="admission-page">
<section class="admission-card" aria-labelledby="form-title">
<h1 id="form-title">Gym Fitness Admission</h1>
<form id="admission-form" novalidate>
<div class="field-group">
<label for="full-name">Full Name</label>
<input id="full-name" name="fullName" type="text" autocomplete="name" placeholder="Enter your name" required />
<small class="field-message" id="full-name-message" aria-live="polite"></small>
</div>
<div class="field-group">
<label for="email">Email Address</label>
<input id="email" name="email" type="email" autocomplete="email" placeholder="Enter email" required />
<small class="field-message" id="email-message" aria-live="polite"></small>
</div>
<div class="field-group">
<label for="phone">Phone Number</label>
<input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="numeric" placeholder="Enter Number" required />
<small class="field-message" id="phone-message" aria-live="polite"></small>
</div>
<div class="field-group">
<label for="age">Age</label>
<input id="age" name="age" type="number" min="16" max="100" placeholder="20" required />
<small class="field-message" id="age-message" aria-live="polite"></small>
</div>
<div class="form-actions">
<p id="form-status" class="form-status" role="status" aria-live="polite"></p>
<button type="submit">Submit Application</button>
</div>
</form>
<footer class"admission-footer">|
<p>24070521153</p>
</footer>
</section>
</main>
</body>
</html>
