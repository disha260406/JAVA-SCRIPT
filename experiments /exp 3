<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Student Grading System</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial, Helvetica, sans-serif;
}

body{
    background:#eef3ff;
    display:flex;
    justify-content:center;
    align-items:center;
    min-height:100vh;
}

.container{
    width:480px;
    background:white;
    padding:25px;
    border-radius:18px;
    box-shadow:0 10px 25px rgba(0,0,0,.15);
}

h1{
    color:#1d3557;
    margin-bottom:12px;
    font-size:28px;
}

.subtitle{
    margin-bottom:20px;
    color:#333;
}

label{
    display:block;
    margin-top:15px;
    margin-bottom:8px;
    font-weight:bold;
    font-size:20px;
}

input{
    width:100%;
    padding:13px;
    font-size:18px;
    border:1px solid #c9d2df;
    border-radius:12px;
    outline:none;
}

input:focus{
    border:2px solid orange;
}

button{
    width:100%;
    margin-top:18px;
    padding:14px;
    border:none;
    border-radius:12px;
    background:#3466e8;
    color:white;
    font-size:22px;
    cursor:pointer;
}

button:hover{
    background:#2958d7;
}

.result{
    margin-top:30px;
    background:#eefdf1;
    border:1px solid #7be59d;
    border-radius:15px;
    padding:18px;
    display:none;
}

.result h2{
    font-size:22px;
    margin-bottom:18px;
}

.result p{
    margin:12px 0;
    font-size:22px;
}

strong{
    font-weight:bold;
}
</style>

</head>
<body>

<div class="container">

<h1>Student Grading System</h1>

<p class="subtitle">
Enter the student details and marks to calculate the grade.
</p>

<label>PRN</label>
<input type="text" id="prn">

<label>Student Name</label>
<input type="text" id="name">

<label>Marks</label>
<input type="number" id="marks">

<button onclick="calculateGrade()">Calculate Grade</button>

<div class="result" id="result">

<h2>Result</h2>

<p><strong>PRN:</strong> <span id="rprn"></span></p>

<p><strong>Name:</strong> <span id="rname"></span></p>

<p><strong>Marks:</strong> <span id="rmarks"></span></p>

<p><strong>Grade:</strong> <span id="rgrade"></span></p>

<p><strong>Status:</strong> <span id="rstatus"></span></p>

</div>

</div>

<script>

function calculateGrade(){

let prn=document.getElementById("prn").value.trim();
let name=document.getElementById("name").value.trim();
let marks=Number(document.getElementById("marks").value);

if(prn=="" || name=="" || document.getElementById("marks").value==""){
    alert("Please fill all fields.");
    return;
}

if(marks<0 || marks>100){
    alert("Marks should be between 0 and 100.");
    return;
}

let grade;

if(marks>=90){
    grade="A+";
}
else if(marks>=80){
    grade="A";
}
else if(marks>=70){
    grade="B";
}
else if(marks>=60){
    grade="C";
}
else if(marks>=50){
    grade="D";
}
else{
    grade="F";
}

let status=(marks>=40)?"Pass":"Fail";

document.getElementById("rprn").innerHTML=`${prn}`;
document.getElementById("rname").innerHTML=`${name}`;
document.getElementById("rmarks").innerHTML=`${marks}`;
document.getElementById("rgrade").innerHTML=`${grade}`;
document.getElementById("rstatus").innerHTML=`${status}`;

document.getElementById("result").style.display="block";

}

</script>

</body>
</html>
