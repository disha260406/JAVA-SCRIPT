document.getElementById('analyze-btn').addEventListener('click', runAnalysis);

function runAnalysis() {
    const mainText = document.getElementById('main-text').value;
    const emailToValidate = document.getElementById('email-to-validate').value;
   
    // 1. Handle Email Validation Output
    const validationContainer = document.getElementById('validation-result-container');
    const isValidEmail = validateEmailFormat(emailToValidate);
    validationContainer.textContent = `Validation result for "${emailToValidate}": ${isValidEmail ? 'Valid' : 'Invalid'}`;
   
    // 2. Extracted Emails (matching snapshot behavior where commas/strings without spaces are evaluated)
    // Note: The snapshot outputs "None" even with "disha@gmail.com,9782325485" because standard word-splitting on spaces leaves the comma attached.
    const emailsFound = extractEmailsWithSpaces(mainText);
    const emailsDisplay = emailsFound.length > 0 ? emailsFound.join(', ') : 'None';

    // 3. Text Transformations
    const uppercaseText = mainText.toUpperCase();
    const lowercaseText = mainText.toLowerCase();
   
    // 4. Content Checks
    const containsWelcome = mainText.includes('Welcome');
    const textLength = mainText.length;
   
    // 5. Word Counting (splits strictly by spaces to match "Number of Words: 1" from the image)
    const wordCount = mainText.trim() === "" ? 0 : mainText.trim().split(/\s+/).length;
   
    // 6. Target Substring Occurrences
    const occurrencesOfEmail = countSubstringOccurrences(mainText, 'email');

    // Compile text blocks exactly as shown in the screenshot layout
    const resultsTemplate =
`Extracted Emails: ${emailsDisplay}
Text in Uppercase: ${uppercaseText}
Text in Lowercase: ${lowercaseText}
Contains "Welcome": ${containsWelcome}
Text Length: ${textLength}
Number of Words: ${wordCount}
Occurrences of "email": ${occurrencesOfEmail}`;

    document.getElementById('analysis-output').textContent = resultsTemplate;
}

// Regex matching standard space-delimited text evaluation seen in basic utility apps
function extractEmailsWithSpaces(text) {
    const words = text.split(/\s+/);
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return words.filter(word => emailRegex.test(word));
}

// Basic structural evaluation helper
function validateEmailFormat(email) {
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return emailRegex.test(email);
}

// Substring frequency counter
function countSubstringOccurrences(sourceText, searchStr) {
    if (!searchStr) return 0;
    let count = 0;
    let position = sourceText.indexOf(searchStr);
    while (position !== -1) {
        count++;
        position = sourceText.indexOf(searchStr, position + 1);
    }
    return count;
}
